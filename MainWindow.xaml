<Window x:Class="infex1rn.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:infex1rn"
        xmlns:viewModels="clr-namespace:infex1rn.ViewModels"
        mc:Ignorable="d"
        Title="infex1rn" Height="450" Width="800">
    <Window.DataContext>
        <viewModels:MainViewModel/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
            <Button Content="List Devices" Command="{Binding ListDevicesCommand}" Margin="10" />
            <ListView ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Margin="10" />
        </StackPanel>

        <TabControl Grid.Column="1" Margin="10">
            <TabItem Header="Device Information">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Label Content="Device Name:" Grid.Row="0" Grid.Column="0" Margin="5" />
                    <TextBox Text="{Binding DeviceName}" Grid.Row="0" Grid.Column="1" Margin="5" IsReadOnly="True" />

                    <Label Content="Model:" Grid.Row="1" Grid.Column="0" Margin="5" />
                    <TextBox Text="{Binding Model}" Grid.Row="1" Grid.Column="1" Margin="5" IsReadOnly="True" />

                    <Label Content="iOS Version:" Grid.Row="2" Grid.Column="0" Margin="5" />
                    <TextBox Text="{Binding IOSVersion}" Grid.Row="2" Grid.Column="1" Margin="5" IsReadOnly="True" />

                    <Label Content="Serial Number:" Grid.Row="3" Grid.Column="0" Margin="5" />
                    <TextBox Text="{Binding SerialNumber}" Grid.Row="3" Grid.Column="1" Margin="5" IsReadOnly="True" />
                </Grid>
            </TabItem>
            <TabItem Header="App Management">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListView ItemsSource="{Binding Apps}" Margin="10" Grid.Row="0" />
                    <Button Content="Install IPA" Command="{Binding InstallIpaCommand}" Margin="10,0,10,10" Grid.Row="1" />
                    <ProgressBar Value="{Binding InstallationProgress}" Height="20" Margin="10,0,10,10" Grid.Row="2" />
                </Grid>
            </TabItem>
            <TabItem Header="File Manager">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox ItemsSource="{Binding FileSharingApps}" SelectedItem="{Binding SelectedFileSharingApp}" Margin="10" Grid.Row="0" DisplayMemberPath="Key" />
                    <TreeView ItemsSource="{Binding AppFileTree}" Margin="10,0,10,10" Grid.Row="1" />
                </Grid>
            </TabItem>
            <TabItem Header="System Utilities">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0">
                        <Button Content="Enter Recovery Mode" Command="{Binding EnterRecoveryCommand}" Margin="10" />
                        <Button Content="Exit Recovery Mode" Command="{Binding ExitRecoveryCommand}" Margin="10" />
                        <Button Content="Load Ramdisk" Command="{Binding LoadRamdiskCommand}" Margin="10" />
                        <Button Content="Enter PwnDFU" Command="{Binding EnterPwnDfuCommand}" Margin="10" />
                        <Button Content="Enter Purple Mode" Command="{Binding EnterPurpleModeCommand}" Margin="10" />
                        <Button Content="Bypass Activation Lock" Command="{Binding BypassActivationLockCommand}" Margin="10" />
                        <Button Content="Ramdisk Exploit (checkm8)" Command="{Binding RamdiskExploitCommand}" Margin="10" />
                        <Button Content="A10 Hello Bypass (Signals)" Command="{Binding A10HelloBypassCommand}" Margin="10" />
                        <Button Content="Auto Extract Ramdisk (from IPSW)" Command="{Binding AutoExtractRamdiskCommand}" Margin="10" Background="#FF2196F3" Foreground="White" ToolTip="Automatically extract and patch ramdisk from IPSW to remove Setup.app" />
                        <Button Content="Untethered Bypass" Command="{Binding UnthetheredBypassCommand}" Margin="10" Background="#FF4CAF50" Foreground="White" />
                        <Button Content="Palera1n Jailbreak" Command="{Binding Palera1nJailbreakCommand}" Margin="10" Background="#FF9C27B0" Foreground="White" ToolTip="Semi-tethered jailbreak for A8-A11 devices using checkm8 exploit. Supports iOS 15-18. Choose rootful or rootless mode." />
                    </StackPanel>
                    <TextBox Grid.Row="1" Text="{Binding ToolOutput}" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="10" />
                </Grid>
            </TabItem>
            <TabItem Header="CFW Studio">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Button Content="Load IPSW" Command="{Binding LoadIpswCommand}" Margin="10" Grid.Row="0" />
                    <Button Content="Extract Ramdisk" Command="{Binding ExtractRamdiskCommand}" IsEnabled="{Binding IsRamdiskPresent}" Margin="10,0,10,10" Grid.Row="1" />
                    <TreeView ItemsSource="{Binding IpswTree}" Margin="10,0,10,10" Grid.Row="2">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Extract..." Command="{Binding ExtractIpswCommand}" />
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Grid>
            </TabItem>
            <TabItem Header="Ramdisk Studio">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Button Content="Load Ramdisk" Command="{Binding LoadRamdiskFileCommand}" Margin="10" Grid.Row="0" />
                    <TreeView ItemsSource="{Binding RamdiskTree}" Margin="10,0,10,10" Grid.Row="1" />
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Add File" Command="{Binding AddFileToRamdiskCommand}" Margin="10" />
                        <Button Content="Remove File" Command="{Binding RemoveFileFromRamdiskCommand}" Margin="10" />
                        <Button Content="Save Ramdisk" Command="{Binding SaveRamdiskCommand}" Margin="10" />
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
